# Copy this file to .env and fill in your key. Without a key, Nightingale runs in demo mode.
# Never commit .env: it holds your key and is listed in .gitignore.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Two-tier routing. Run `python -m app.cli models` to see the exact Nemotron IDs your key can use.
TRIAGE_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
DIAGNOSIS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
AUTO_DISCOVER_MODELS=true

# Set to 1 to use the offline stand-in models even when a key is set (no credits used).
MOCK_MODE=0

# Simulated data center size: 256, 1024, 2048 or 4096 GPUs (8 per server, 64 per rack).
# You can also change it from the Simulation screen while it runs.
NUM_GPUS=1024

# This computer's own NVIDIA GPU, read through nvidia-smi (watch only).
# Connected at startup when nvidia-smi is found. Set LOCAL_GPU=false to stop that.
LOCAL_GPU=true
# A simulated RTX laptop and a pretend Windows, for demos on machines without one.
DEMO_PC=false
LOCAL_POLL_SECONDS=2
# NVIDIA_SMI=C:\Windows\System32\nvidia-smi.exe

# Simulation speed: one tick every TICK_SECONDS, a triage scan every TRIAGE_EVERY_TICKS ticks.
TICK_SECONDS=2
TRIAGE_EVERY_TICKS=5

# Let low-risk steps (power cap, ticket, notify owner) run without a click.
AUTO_APPROVE_LOW_RISK=false

# USD per 1M tokens, used only for the cost panel. Check the Token Factory pricing page.
TRIAGE_PRICE_IN=0.06
TRIAGE_PRICE_OUT=0.24
DIAGNOSIS_PRICE_IN=1.00
DIAGNOSIS_PRICE_OUT=3.00
